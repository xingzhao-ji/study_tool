{
  "name": "goodnotes-companion-tutor-mac-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "mkdir -p .tmp && TMPDIR=$PWD/.tmp node --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "mkdir -p .tmp && TMPDIR=$PWD/.tmp tsx --test src/*.test.ts src/**/*.test.ts",
    "test:codex-provider": "mkdir -p .tmp && TMPDIR=$PWD/.tmp node --import tsx --test src/providers/CodexPrivateLocalProvider.test.ts",
    "smoke": "mkdir -p .tmp && TMPDIR=$PWD/.tmp node --import tsx src/scripts/smoke.ts",
    "simulate": "mkdir -p .tmp && TMPDIR=$PWD/.tmp node --import tsx src/scripts/simulate.ts"
  },
  "dependencies": {
    "express": "^4.18.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.30",
    "tsx": "^4.7.1",
    "typescript": "^5.4.3"
  }
}
